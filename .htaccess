RewriteEngine On

# Clean canonical URLs.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+plan-base2\.html[\s?] [NC]
RewriteRule ^plan-base2\.html$ /base-digital [R=301,L]
RewriteCond %{THE_REQUEST} \s/+sobremi\.html[\s?] [NC]
RewriteRule ^sobremi\.html$ /sobre-mi [R=301,L]
RewriteCond %{THE_REQUEST} \s/+presupuestos-facturacion-rapida\.html[\s?] [NC]
RewriteRule ^presupuestos-facturacion-rapida\.html$ /presupuestos-facturacion-rapida [R=301,L]
RewriteCond %{THE_REQUEST} \s/+digitalizar-documentos\.html[\s?] [NC]
RewriteRule ^digitalizar-documentos\.html$ /digitalizar-documentos [R=301,L]
RewriteCond %{THE_REQUEST} \s/+contacto\.html[\s?] [NC]
RewriteRule ^contacto\.html$ /contacto [R=301,L]

# Legacy pages redirected to current priority pages.
RewriteRule ^(facturas-automaticas|lectura-albaranes)(\.html)?/?$ /presupuestos-facturacion-rapida [R=301,L]
RewriteRule ^(adios-excel|automatizacion-email|automatizaciones|avisos-whatsapp-telegram|gestion-citas|informes-consumos|plan-base|recordatorios-automaticos|plan-avanzado|automatizar-procesos)(\.html)?/?$ / [R=301,L]

# Serve clean URLs from the current static HTML files.
RewriteRule ^base-digital/?$ plan-base2.html [L]
RewriteRule ^sobre-mi/?$ sobremi.html [L]
RewriteRule ^presupuestos-facturacion-rapida/?$ presupuestos-facturacion-rapida.html [L]
RewriteRule ^digitalizar-documentos/?$ digitalizar-documentos.html [L]
RewriteRule ^contacto/?$ contacto.html [L]
